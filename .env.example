# ==============================================================================
# Repository Mentor AI — Configuration Blueprint (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with pgvector support)
# ------------------------------------------------------------------------------
# For local Docker development, use the postgres service name:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/repository_mentor
# For production (e.g. Supabase connection), use your transaction pooler link:
# DATABASE_URL=postgresql://postgres.xxxxxx:[PASSWORD]@aws-1-xxxx.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. AI Inference Engine (Groq Cloud API)
# ------------------------------------------------------------------------------
# Required for RAG codebase query and expert recommendations:
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 3. Supabase Metadata Sync (Optional)
# ------------------------------------------------------------------------------
# Used only if backing up repository structures or syncing auth context:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ------------------------------------------------------------------------------
# 4. Frontend Web UI Configuration
# ------------------------------------------------------------------------------
# Decoupled frontend connection endpoint pointing to the backend API:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 5. CORS Origins (JSON list format)
# ------------------------------------------------------------------------------
# CORS_ORIGINS=["https://repository-mentor.vercel.app", "http://localhost:3000"]
